      },
      "body": "{\"topic\":\"arena\",\"title\":\"ghost ntfy.listen.up expired\",\"message\":\"ghost ntfy.listen.up is expired ()\\nriemann-go: {\\\"rule\\\":\\\"listener-up\\\",\\\"version\\\":1,\\\"owner\\\":\\\"ops\\\",\\\"host\\\":\\\"ghost\\\",\\\"service\\\":\\\"ntfy.listen.up\\\",\\\"state\\\":\\\"expired\\\",\\\"metric\\\":null,\\\"prior_state\\\":\\\"ok\\\",\\\"node\\\":\\\"changed-state\\\"}\",\"priority\":3,\"tags\":[\"hourglass\",\"rule:listener-up\",\"owner:ops\"]}"
    }
  ],
  "harness_events": [
