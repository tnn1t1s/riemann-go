#!/usr/bin/env python3
"""Run the Gherkin corpus against a riemannd candidate through pytest-bdd.

The development corpus is features/*.feature. The held-out set under
features/holdout/ runs only with --holdout, as a promotion run; its failures
must not feed a spec edit (features/holdout/README.md).
"""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--command', required=True, help='Candidate as a JSON argv array; command[0] is the absolute riemannd path')
p.add_argument('--features', default=str(root / 'features'), help='Feature file or directory')
p.add_argument('--out', default='reports/trial')
p.add_argument('--spec', default=str(root / 'SPEC.md'), help='The SPEC.md the candidate was generated from')
p.add_argument('--build-manifest', help='build-manifest.json binding the artifact to that SPEC.md')
p.add_argument('--unbound', action='store_true', help='Waive the binding check; the report records the waiver')
p.add_argument('--holdout', action='store_true', help='Also run features/holdout/ (promotion run)')
p.add_argument('--ready-timeout', type=float, default=15.0)
p.add_argument('-k', default='', help='pytest scenario selection expression')
p.add_argument('-m', default='', help='pytest tag selection expression')
a = p.parse_args()
try:
    command = json.loads(a.command)
    if not isinstance(command, list) or not command or not all(isinstance(v, str) and v for v in command):
        raise ValueError('command must be a nonempty JSON string array')
except ValueError as exc:
    p.error(str(exc))
if not a.build_manifest and not a.unbound:
    p.error('pass --build-manifest, or --unbound to waive the binding check')
out = Path(a.out).resolve()
out.mkdir(parents=True, exist_ok=True)
env = dict(os.environ, RIEMANN_GO_FEATURES=str(Path(a.features).resolve()))
env['RIEMANN_GO_HOLDOUT'] = '1' if a.holdout else '0'
args = [sys.executable, '-m', 'pytest', 'features/test_features.py', '-p', 'no:cacheprovider',
        '--riemann-command', json.dumps(command), '--riemann-out', str(out),
        '--riemann-spec', str(Path(a.spec).resolve()),
        '--riemann-ready-timeout', str(a.ready_timeout),
        '--junitxml', str(out / 'junit.xml'), '-v']
if a.build_manifest:
    args += ['--riemann-build-manifest', str(Path(a.build_manifest).resolve())]
if a.unbound:
    args += ['--riemann-unbound']
if a.k:
    args += ['-k', a.k]
if a.m:
    args += ['-m', a.m]
raise SystemExit(subprocess.call(args, cwd=root, env=env))
