#!/usr/bin/env python3
"""Generate a riemannd candidate through riemann-generate with riemann-go's inputs.

The shared script prepares a pinned input directory, runs the agent command
from the JSON argv file with the prompt on stdin, checks that no input byte
changed, verifies output/build-manifest.json against output/service and the
SPEC.md bytes, and publishes service, build-manifest.json and SPEC.md into the
build directory. Attempt evidence stays under <build>/generations/.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from harness.inputs import INPUTS, PROMPT, ROOT, arguments
from riemann_harness.generate import main

missing = [name for name in INPUTS if not (ROOT / name).is_file()] + ([] if PROMPT.is_file() else [str(PROMPT)])
if missing:
    sys.exit('bin/generate: missing generator input: ' + ', '.join(missing)
             + '. The reading order is fixed in bin/prompt.md; write the document or remove it there.')
sys.exit(main(sys.argv[1:] + arguments()))
