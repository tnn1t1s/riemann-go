#!/usr/bin/env python3
"""Run the arena loop: generate, trial, diagnose, until GREEN, DEGRADED or the iteration cap.

Each iteration generates a candidate through bin/generate into its own build
directory, runs bin/trial over the development corpus, reads summary.json and
hands the first failure to bin/diagnose, which runs in its own context. This
script never edits SPEC.md: deciding whether a failure is a spec gap, a missing
scenario or a bad roll is the orchestrator's judgment, and the next iteration
re-reads the inputs from disk, so an edit landed between iterations is picked
up with no plumbing.

Early stops:
  observer_error  the oracle misread; the generation is unjudged and
                  continuing would charge a harness defect to the generator.
  DEGRADED        fewer scenarios passed than in the previous iteration; the
                  edits landed between iterations made it worse.
"""
import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
p.add_argument('--model', required=True, help='Exact model identifier; one of the pins, never defaulted')
p.add_argument('--command-file', default=str(ROOT / 'agent-command.json'))
p.add_argument('--max-iter', type=int, default=3,
               help='Iteration cap. Default 3: a failure that survives three generations is a spec gap, not a bad roll')
p.add_argument('--out', default=str(ROOT / 'scratch/iterate'))
a = p.parse_args()
out = Path(a.out).resolve()
out.mkdir(parents=True, exist_ok=True)
prev_passed = -1
for i in range(1, a.max_iter + 1):
    build = out / f'iter-{i}'
    print(f'\n{"=" * 64}\nITERATION {i} / {a.max_iter}: {build}\n{"=" * 64}\n[generate]', flush=True)
    rc = subprocess.call([sys.executable, str(ROOT / 'bin/generate'), '--model', a.model,
                          '--command-file', a.command_file, '--build-dir', str(build)])
    if rc:
        print(f'\ncompile_error at iteration {i}: generation did not produce a bound artifact.\n'
              f'Read the newest agent.log under {build / "generations"}. A dependency or layout error\n'
              'is usually a spec gap; a type error inside one package is usually a bad roll.')
        prev_passed = 0
        continue
    print('\n[trial]', flush=True)
    subprocess.call([sys.executable, str(ROOT / 'bin/test-build'), '--build-dir', str(build)])
    summary_path = build / 'reports/summary.json'
    if not summary_path.exists():
        print(f'\nOBSERVER ERROR at iteration {i}: no summary at {summary_path}; the trial did not run to a verdict.')
        sys.exit(3)
    summary = json.loads(summary_path.read_text())
    bad = [s for s in summary['scenarios'] if s['category'] == 'observer_error']
    if bad:
        print(f'\n{"=" * 64}\nOBSERVER ERROR on {bad[0]["scenario"]} at iteration {i}\n'
              'The oracle misread. This generation is unjudged. Fix the harness and re-run;\n'
              f'do not charge this to the generator. Evidence: {bad[0]["report_dir"]}\n{"=" * 64}')
        sys.exit(3)
    passed, total = summary['green'], summary['total']
    print(f'\npassed {passed} / {total}')
    if passed == total:
        print(f'\n{"=" * 64}\nGREEN at iteration {i}\ncandidate ready to promote: {build}\n'
              f'see GENERATE.md for the release layout\n{"=" * 64}')
        sys.exit(0)
    if prev_passed >= 0 and passed < prev_passed:
        print(f'\n{"=" * 64}\nDEGRADED at iteration {i}: {prev_passed} passed, now {passed}\n'
              'The edits landed between iterations made it worse. Stop and read them\n'
              f'before generating again.\n{"=" * 64}')
        sys.exit(4)
    prev_passed = passed
    first = next(s for s in summary['scenarios'] if s['category'] != 'GREEN')
    print(f'\n[diagnose] {first["scenario"]} ({first["category"]})', flush=True)
    subprocess.call([sys.executable, str(ROOT / 'bin/diagnose'), first['report_dir']])
    if i < a.max_iter:
        print(f'\nIteration {i} did not reach GREEN. Act on the diagnosis above: edit SPEC.md,\n'
              f'add a scenario, or accept the roll and continue. Iteration {i + 1} re-reads the inputs from disk.')
print(f'\n{"=" * 64}\nNEEDS-HUMAN after {a.max_iter} iterations\n'
      f'A failure that survives {a.max_iter} generations is a spec gap, not a bad roll.\n{"=" * 64}')
sys.exit(2)
