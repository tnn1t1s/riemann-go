#!/usr/bin/env python3
"""Validate feature bindings and data, then test the harness. No product verdict."""
import os
import subprocess
import sys
import tempfile
from pathlib import Path

root = Path(__file__).resolve().parents[1]
env = dict(os.environ)
env.pop('RIEMANN_GO_FEATURES', None)
# Validation parses the held-out set too: a malformed holdout should fail here,
# not at promotion. Validation reads data shape only and renders no verdict.
env['RIEMANN_GO_HOLDOUT'] = '1'
with tempfile.TemporaryDirectory(prefix='riemann-go-feature-validation-') as out:
    result = subprocess.call([sys.executable, '-m', 'pytest', 'features/test_features.py',
                              '-p', 'no:cacheprovider', '--riemann-validate',
                              '--riemann-out', out, '-q'], cwd=root, env=env)
    if result:
        raise SystemExit(result)
print('Gherkin binding/data validation complete; running harness self-tests.', flush=True)
env.pop('RIEMANN_GO_HOLDOUT', None)
raise SystemExit(subprocess.call([sys.executable, '-m', 'pytest', 'tests', '-p', 'no:cacheprovider', '-q'],
                                 cwd=root, env=env))
