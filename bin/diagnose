#!/usr/bin/env python3
"""Run the diagnostician on one failed trial case.

Takes the case directory bin/trial wrote (report.json, trace.jsonl and
candidate.log). Invokes `claude -p` with the diagnostician prompt and
read-only file access, in its own context. The diagnostician does not read
the generated source: it reasons from the spec, the feature file and what
the sink receiver observed. The diagnosis is written beside the report as
diagnosis-<timestamp>.md and printed.
"""
import argparse
import json
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('case', help='Trial case directory holding report.json, trace.jsonl and candidate.log')
p.add_argument('--max-turns', type=int, default=15)
a = p.parse_args()
case = Path(a.case).resolve()
paths = {
    '__SPEC_PATH__': ROOT / 'SPEC.md',
    '__HARNESS_PATH__': ROOT / 'HARNESS.md',
    '__REPORT_PATH__': case / 'report.json',
    '__TRACE_PATH__': case / 'trace.jsonl',
    '__LOG_PATH__': case / 'candidate.log',
}
missing = [str(v) for v in paths.values() if not v.is_file()]
if missing:
    sys.exit('bin/diagnose: missing input: ' + ', '.join(missing)
             + '\nA diagnosis without the trace or the log is speculation; refusing.')
report = json.loads(paths['__REPORT_PATH__'].read_text())
feature = Path(report.get('feature_file', ''))
if not feature.is_file():
    sys.exit('bin/diagnose: report.json names no readable feature file')
if report.get('category') == 'GREEN':
    print('No diagnosis required: category is GREEN. Orchestrator should promote, not diagnose.')
    sys.exit(0)
if not shutil.which('claude'):
    sys.exit("bin/diagnose: 'claude' not on PATH; the diagnostician cannot run.")
prompt = (ROOT / 'bin/diagnose-prompt.md').read_text()
for key, value in paths.items():
    prompt = prompt.replace(key, str(value))
prompt = prompt.replace('__FEATURE_PATH__', str(feature)).replace('__SCENARIO_NAME__', report.get('scenario_name', ''))
out = case / f'diagnosis-{time.strftime("%Y%m%d-%H%M%S")}.md'
print(f'diagnosing {report.get("scenario_name")} ...', file=sys.stderr)
with out.open('w') as fh:
    rc = subprocess.call(['claude', '-p', prompt, '--allowedTools', 'Read', '--max-turns', str(a.max_turns)], stdout=fh)
print(f'diagnosis written to: {out}\n', file=sys.stderr)
print(out.read_text())
sys.exit(rc)
