probes/*/probe[0-9]
probes/**/__pycache__/
probes/**/*.log

# Generations in progress and loop output. A generation that passes is
# promoted into releases/; one that does not stays here with its evidence.
scratch/*
!scratch/.gitkeep
/build/
/build-*/

# Built binaries. The binaries belonging to a release are GitHub release
# assets; nothing else is committed.
riemannd

# Trial output. Evidence that outlives a run is copied into releases/<trust>/<gen-id>/
# when a candidate lands, or into failures/promoted/ when a failure becomes a scenario.
reports/*
!reports/.gitkeep

.venv/
__pycache__/
*.pyc
.pytest_cache/
